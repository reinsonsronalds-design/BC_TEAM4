# Copy to /opt/slice-sip-demo/infrastructure/terraform.tfvars on the EC2 CI host.
# This is a new Terraform state root and never manages the existing ECR repos.
aws_region = "eu-west-1"
project_name = "slice-sip"
existing_ci_instance_id = "i-0eb789ac23be694c0"
existing_vpc_id = "vpc-04b6091923e283784"
# Verify IGW / NAT routes, subnet permissions, and distinct AZs FIRST.
alb_public_subnet_ids = ["subnet-09499899162c048f7", "subnet-0085786c1374a372c"]
ecs_subnet_ids = ["subnet-0d967012a216e6162", "subnet-044a7aac53c2aa425"]
ecs_assign_public_ip = false
# The host orchestrator supplies enable_application=true and immutable image_tag
# ONLY after tests and Kaniko pushes have succeeded.
# Secret injection requires independent task EXECUTION role permissions and
# pre-populated secrets. Disabled until verified.
enable_discord_webhooks = false
# discord_webhook_secret_arns = {
#   orders = "arn:aws:secretsmanager:eu-west-1:597765856364:secret:..."
#   invoices = "arn:aws:secretsmanager:eu-west-1:597765856364:secret:..."
#   support = "arn:aws:secretsmanager:eu-west-1:597765856364:secret:..."
# }
